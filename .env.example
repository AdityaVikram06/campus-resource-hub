# ==============================================================================
# CAMPUS DOCUMENT HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API Configuration
# Used by the AI Assistant to query document page text and deliver precise citations
ANTHROPIC_API_KEY=sk-ant-api03-...

# Next.js App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
