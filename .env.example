# ==============================================================================
# CAMPUS DOCUMENT HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Configuration (Server-Side Only)
# Used by the AI Assistant to query document page text and deliver precise citations
GEMINI_API_KEY=your-gemini-api-key

# Adobe PDF Embed API Client ID (Client-Side)
# Get from https://developer.adobe.com/document-services/apis/pdf-embed/
NEXT_PUBLIC_ADOBE_PDF_EMBED_CLIENT_ID=your-adobe-pdf-embed-client-id

# Next.js App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backblaze B2 Cloud Storage (Server-Side Only - Private 'Resources-hub' Bucket)
# Generated from Backblaze B2 dashboard, scoped specifically to bucket 'Resources-hub'
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=Resources-hub
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
MAX_UPLOAD_SIZE_MB=25
